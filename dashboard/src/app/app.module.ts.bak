import { NgModule, CUSTOM_ELEMENTS_SCHEMA } from '@angular/core';
import { BrowserModule } from '@angular/platform-browser';
import { RouterModule, Routes } from '@angular/router';
import { FormsModule } from '@angular/forms';
import { HttpClientModule } from '@angular/common/http';

import { AppComponent } from './app.component';
import { SidebarComponent } from './layout/sidebar/sidebar.component';
import { TopbarComponent } from './layout/topbar/topbar.component';

// Importez vos composants directement (sans lazy loading pour simplifier)
import { DashboardComponent } from './features/dashboard/dashboard.component';
import { AngularDashboardComponent } from './features/dashboard/angular-dashboard/angular-dashboard.component';
import { LoginComponent } from './features/auth/login/login.component';
import { InspectionsComponent } from './features/inspections/inspections.component';
import { UsersListComponent } from './features/admin/users/users-list.component';

const routes: Routes = [
  { path: 'login', component: LoginComponent },
  { path: 'dashboard', component: DashboardComponent },
  { path: 'angular-dashboard', component: AngularDashboardComponent },
  { path: 'inspections', component: InspectionsComponent },
  { path: 'admin/users', component: UsersListComponent },
  { path: '', redirectTo: '/dashboard', pathMatch: 'full' }
];

@NgModule({
  declarations: [
    AppComponent,
    SidebarComponent,
    TopbarComponent,
    DashboardComponent,
    AngularDashboardComponent,
    LoginComponent,
    InspectionsComponent,
    UsersListComponent
  ],
  imports: [
    BrowserModule,
    FormsModule,
    HttpClientModule,
    RouterModule.forRoot(routes)
  ],
  providers: [],
  bootstrap: [AppComponent],
  schemas: [CUSTOM_ELEMENTS_SCHEMA]
})
export class AppModule { }